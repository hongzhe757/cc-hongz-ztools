<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>cc.hongz</groupId>
        <artifactId>cc-hongz-parent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>cc-hongz-ztools</artifactId>
    <packaging>pom</packaging>

    <name>cc-hongz-ztools</name>
    <description>工具集合模块</description>

    <!-- ============ 统一版本号集中管理 ============ -->
    <!-- 所有第三方库版本号在此集中定义，子模块 pom 引用 ${xxx.version}，不散落硬编码 -->
    <properties>
        <!-- 测试框架（所有模块共用） -->
        <junit.version>5.10.3</junit.version>
        <lombok.version>1.18.34</lombok.version>

        <!-- aop：动态代理 -->
        <cglib.version>3.3.0</cglib.version>
        <spring.version>6.2.18</spring.version>

        <!-- cron：定时任务 -->
        <quartz.version>2.4.0</quartz.version>

        <!-- poi：Office 文档 -->
        <poi.version>5.4.0</poi.version>

        <!-- system：系统/硬件信息采集 -->
        <oshi.version>6.6.2</oshi.version>

        <!-- db：连接池 + NoSQL -->
        <c3p0.version>0.12.0</c3p0.version>
        <dbcp2.version>2.12.0</dbcp2.version>
        <tomcat-jdbc.version>10.0.23</tomcat-jdbc.version>
        <druid.version>1.2.23</druid.version>
        <hikariCP.version>4.0.3</hikariCP.version>
        <mongo4.version>4.9.1</mongo4.version>
        <jedis.version>5.0.2</jedis.version>
        <sqlite.version>3.46.0.1</sqlite.version>
        <hsqldb.version>2.7.4</hsqldb.version>

        <!-- extra：模板 / 邮件 / SSH / 拼音 / 分词等 -->
        <velocity.version>2.3</velocity.version>
        <beetl.version>3.15.14.RELEASE</beetl.version>
        <rythm.version>1.4.2</rythm.version>
        <freemarker.version>2.3.32</freemarker.version>
        <enjoy.version>5.1.3</enjoy.version>
        <thymeleaf.version>3.1.5.RELEASE</thymeleaf.version>
        <mail.version>1.6.2</mail.version>
        <jsch.version>0.1.55</jsch.version>
        <sshj.version>0.40.0</sshj.version>
        <zxing.version>3.5.3</zxing.version>
        <net.version>3.9.0</net.version>
        <emoji-java.version>5.1.1</emoji-java.version>
        <servlet-api.version>4.0.1</servlet-api.version>
        <spring-boot.version>2.7.18</spring-boot.version>
    </properties>

    <!-- ============ 依赖版本管理（dependencyManagement） ============ -->
    <!-- 多模块共用的依赖在此声明版本，子模块只写 groupId:artifactId，不写 version -->
    <dependencyManagement>
        <dependencies>
            <!-- 测试框架：JUnit5（所有模块测试共用） -->
            <dependency>
                <groupId>org.junit.jupiter</groupId>
                <artifactId>junit-jupiter</artifactId>
                <version>${junit.version}</version>
                <scope>test</scope>
            </dependency>
            <!-- 测试辅助：Lombok（测试代码去样板） -->
            <dependency>
                <groupId>org.projectlombok</groupId>
                <artifactId>lombok</artifactId>
                <version>${lombok.version}</version>
                <scope>test</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <plugins>
            <!-- checkstyle 代码规范检查：绑定 validate 阶段，违规不阻断构建（failOnViolation=false） -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-checkstyle-plugin</artifactId>
                <version>3.1.1</version>
                <dependencies>
                    <dependency>
                        <groupId>com.puppycrawl.tools</groupId>
                        <artifactId>checkstyle</artifactId>
                        <version>8.45</version>
                    </dependency>
                </dependencies>
                <configuration>
                    <!-- 检查规则文件 -->
                    <configLocation>checks/checkstyle.xml</configLocation>
                    <!-- 违规豁免规则（如测试类 MagicNumber/MissingJavadocMethod 豁免） -->
                    <suppressionsLocation>checks/checkstyle-suppressions.xml</suppressionsLocation>
                    <!-- 同时检查测试代码（src/test） -->
                    <includeTestSourceDirectory>true</includeTestSourceDirectory>
                    <!-- 违规不阻断构建，仅告警 -->
                    <failOnViolation>false</failOnViolation>
                    <!-- 违规级别记为 error（用于 IDE/日志高亮） -->
                    <violationSeverity>error</violationSeverity>
                </configuration>
                <executions>
                    <execution>
                        <id>checkstyle</id>
                        <phase>validate</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <!-- surefire 单元测试：JVM 加 add-opens 解决 JDK17 模块化反射限制（cglib/反射需访问 java.lang 等内部包） -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <argLine>--add-opens java.base/java.net=ALL-UNNAMED --add-opens java.base/java.lang.reflect=ALL-UNNAMED --add-opens java.base/java.lang=ALL-UNNAMED</argLine>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <modules>
        <!-- ============ 核心基础 ============ -->
        <!-- 基础工具类库，其余模块的依赖基座 -->
        <module>cc-hongz-ztools-core</module>

        <!-- ============ 通用工具 ============ -->
        <!-- 三方库整合（模板/邮件/拼音/分词/表达式等） -->
        <module>cc-hongz-ztools-extra</module>
        <!-- 配置读取（Properties/Yaml/多环境 Profile） -->
        <module>cc-hongz-ztools-setting</module>
        <!-- 系统/硬件信息采集（OSHI） -->
        <module>cc-hongz-ztools-system</module>
        <!-- 日志门面（多框架 SPI 适配） -->
        <module>cc-hongz-ztools-log</module>
        <!-- JSON 解析/序列化 -->
        <module>cc-hongz-ztools-json</module>

        <!-- ============ 网络通信 ============ -->
        <!-- HTTP 客户端 + 简易服务器 -->
        <module>cc-hongz-ztools-http</module>
        <!-- Socket 通信（NIO/AIO） -->
        <module>cc-hongz-ztools-socket</module>

        <!-- ============ 数据存储 ============ -->
        <!-- JDBC ORM（多方言 + 多连接池） -->
        <module>cc-hongz-ztools-db</module>
        <!-- 本地缓存（FIFO/LFU/LRU/Timed/Weak） -->
        <module>cc-hongz-ztools-cache</module>
        <!-- DFA 敏感词过滤 -->
        <module>cc-hongz-ztools-dfa</module>
        <!-- 布隆过滤器 -->
        <module>cc-hongz-ztools-bloomFilter</module>

        <!-- ============ 安全加密 ============ -->
        <!-- 加解密（对称/非对称/摘要/国密） -->
        <module>cc-hongz-ztools-crypto</module>
        <!-- JWT 令牌（对称/非对称签名） -->
        <module>cc-hongz-ztools-jwt</module>

        <!-- ============ 文档 / 媒体 ============ -->
        <!-- Office 文档（Excel/Word/OFD） -->
        <module>cc-hongz-ztools-poi</module>
        <!-- 验证码（线段/圆圈/扭曲/GIF） -->
        <module>cc-hongz-ztools-captcha</module>

        <!-- ============ 任务 / 脚本 ============ -->
        <!-- 定时任务（Cron 表达式 + 时间轮） -->
        <module>cc-hongz-ztools-cron</module>
        <!-- 脚本引擎（JSR-223） -->
        <module>cc-hongz-ztools-script</module>

        <!-- ============ 切面代理 ============ -->
        <!-- 动态代理（JDK/Cglib/SpringCglib） -->
        <module>cc-hongz-ztools-aop</module>

        <!-- ============ AI 能力 ============ -->
        <!-- LLM 调用（OpenAI/DeepSeek/Gemini/Grok/Ollama/豆包） -->
        <module>cc-hongz-ztools-ai</module>

        <!-- ============ 企业自有 ============ -->
        <!-- 统一状态码抽象（业务状态码 + HTTP 状态码，可插拔） -->
        <module>cc-hongz-ztools-status</module>
        <!-- 统一响应封装 -->
        <module>cc-hongz-ztools-response</module>
        <!-- 代码混淆加密保护 -->
        <module>cc-hongz-ztools-protector</module>
        <!-- 代码混淆加密保护端到端演示（引用 aop 动态代理） -->
        <module>cc-hongz-ztools-protector-demo</module>

        <!-- ============ 聚合 / 依赖管理 ============ -->
        <!-- 全量聚合模块（shade 打包所有子模块） -->
        <module>cc-hongz-ztools-all</module>
        <!-- 依赖版本管理 BOM -->
        <module>cc-hongz-ztools-bom</module>
    </modules>
</project>
