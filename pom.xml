<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>cc.hongz</groupId>
        <artifactId>cc-hongz-parent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>cc-hongz-ztools</artifactId>
    <packaging>pom</packaging>

    <name>cc-hongz-ztools</name>
    <description>工具集合模块</description>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-checkstyle-plugin</artifactId>
                <version>3.1.1</version>
                <dependencies>
                    <dependency>
                        <groupId>com.puppycrawl.tools</groupId>
                        <artifactId>checkstyle</artifactId>
                        <version>8.45</version>
                    </dependency>
                </dependencies>
                <configuration>
                    <configLocation>checks/checkstyle.xml</configLocation>
                    <suppressionsLocation>checks/checkstyle-suppressions.xml</suppressionsLocation>
                    <includeTestSourceDirectory>true</includeTestSourceDirectory>
                    <failOnViolation>false</failOnViolation>
                    <violationSeverity>error</violationSeverity>
                </configuration>
                <executions>
                    <execution>
                        <id>checkstyle</id>
                        <phase>validate</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <argLine>--add-opens java.base/java.net=ALL-UNNAMED --add-opens java.base/java.lang.reflect=ALL-UNNAMED --add-opens java.base/java.lang=ALL-UNNAMED</argLine>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <modules>
        <!-- ============ 核心基础 ============ -->
        <!-- 基础工具类库，其余模块的依赖基座 -->
        <module>cc-hongz-ztools-core</module>

        <!-- ============ 通用工具 ============ -->
        <!-- 三方库整合（模板/邮件/拼音/分词/表达式等） -->
        <module>cc-hongz-ztools-extra</module>
        <!-- 配置读取（Properties/Yaml/多环境 Profile） -->
        <module>cc-hongz-ztools-setting</module>
        <!-- 系统/硬件信息采集（OSHI） -->
        <module>cc-hongz-ztools-system</module>
        <!-- 日志门面（多框架 SPI 适配） -->
        <module>cc-hongz-ztools-log</module>
        <!-- JSON 解析/序列化 -->
        <module>cc-hongz-ztools-json</module>

        <!-- ============ 网络通信 ============ -->
        <!-- HTTP 客户端 + 简易服务器 -->
        <module>cc-hongz-ztools-http</module>
        <!-- Socket 通信（NIO/AIO） -->
        <module>cc-hongz-ztools-socket</module>

        <!-- ============ 数据存储 ============ -->
        <!-- JDBC ORM（多方言 + 多连接池） -->
        <module>cc-hongz-ztools-db</module>
        <!-- 本地缓存（FIFO/LFU/LRU/Timed/Weak） -->
        <module>cc-hongz-ztools-cache</module>
        <!-- DFA 敏感词过滤 -->
        <module>cc-hongz-ztools-dfa</module>
        <!-- 布隆过滤器 -->
        <module>cc-hongz-ztools-bloomFilter</module>

        <!-- ============ 安全加密 ============ -->
        <!-- 加解密（对称/非对称/摘要/国密） -->
        <module>cc-hongz-ztools-crypto</module>
        <!-- JWT 令牌（对称/非对称签名） -->
        <module>cc-hongz-ztools-jwt</module>

        <!-- ============ 文档 / 媒体 ============ -->
        <!-- Office 文档（Excel/Word/OFD） -->
        <module>cc-hongz-ztools-poi</module>
        <!-- 验证码（线段/圆圈/扭曲/GIF） -->
        <module>cc-hongz-ztools-captcha</module>

        <!-- ============ 任务 / 脚本 ============ -->
        <!-- 定时任务（Cron 表达式 + 时间轮） -->
        <module>cc-hongz-ztools-cron</module>
        <!-- 脚本引擎（JSR-223） -->
        <module>cc-hongz-ztools-script</module>

        <!-- ============ 切面代理 ============ -->
        <!-- 动态代理（JDK/Cglib/SpringCglib） -->
        <module>cc-hongz-ztools-aop</module>

        <!-- ============ AI 能力 ============ -->
        <!-- LLM 调用（OpenAI/DeepSeek/Gemini/Grok/Ollama/豆包/Hutool） -->
        <module>cc-hongz-ztools-ai</module>

        <!-- ============ 企业自有（非 hutool 移植） ============ -->
        <!-- 统一响应封装 -->
        <module>cc-hongz-ztools-response</module>
        <!-- 代码混淆加密保护 -->
        <module>cc-hongz-ztools-protector</module>

        <!-- ============ 聚合 / 依赖管理 ============ -->
        <!-- 全量聚合模块（shade 打包所有子模块） -->
        <module>cc-hongz-ztools-all</module>
        <!-- 依赖版本管理 BOM -->
        <module>cc-hongz-ztools-bom</module>
    </modules>
</project>
